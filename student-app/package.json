    "electron-builder": "^24.13.0"
  },
  "build": {
    "appId": "com.giftforyou.monitor",
    "productName": "Gift For You",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": ["dir"]
    }
  }
}
