{
  "name": "gift-for-you",
  "version": "1.1.0",
  "private": true,
  "description": "Gift For You — Student Monitoring Desktop App",
  "main": "src/main/main.js",
  "author": "Gift For You",
  "scripts": {
    "dev": "electron .",
    "build": "electron-builder --win nsis",
    "pack": "electron-builder --dir",
    "release": "electron-builder --win nsis --publish always",
    "draft": "electron-builder --win nsis --publish onTagOrDraft"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.9",
    "firebase": "^10.12.0"
  },
  "devDependencies": {
    "electron": "^30.5.1",
    "electron-builder": "^24.13.0"
  },
  "build": {
    "appId": "com.giftforyou.monitor",
    "productName": "Gift For You",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "Nuharian",
        "repo": "gift-for-you"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico",
      "artifactName": "Gift-For-You-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
