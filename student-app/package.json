{
  "name": "gift-for-you",
  "version": "1.0.0",
  "private": true,
  "description": "Gift For You — Student Monitoring Desktop App",
  "main": "src/main/main.js",
  "scripts": {
    "dev": "electron .",
    "build": "electron-builder --win dir",
    "pack": "electron-builder --dir"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "firebase": "^10.12.0"
  },
